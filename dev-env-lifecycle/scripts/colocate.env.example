# Copy to /etc/colocate.env (or pass COLOCATE_ENV=path) and size for the host.
PROD_SLICE=system.slice        # where the production containers' scopes live
DEV_SLICE=user.slice           # where agent sessions and their jobs live
PROD_MEM_LOW=32G               # production working set + hot file cache, not the sum of its limits
DEV_CPU_WEIGHT=40              # vs 100 for production; weights only bite under contention
DEV_MEM_HIGH=80G               # above today's agent usage; throttles growth
DEV_MEM_MAX=96G                # RAM minus production working set minus a system margin
DEV_TASKS_MAX=16384            # fork-storm brake, well above the current task count
OOMD_LIMIT=50%                 # systemd-oomd kill on user@.service memory pressure
OOMD_DURATION=20s
INOTIFY_INSTANCES=1024
# Dev-first host (production serves a few users a day): agents may take ~80 %.
#   PROD_MEM_LOW=16G  DEV_CPU_WEIGHT=400  DEV_MEM_HIGH=<80 % of RAM>  DEV_MEM_MAX=<88 % of RAM>
#   and export HOST_SHARE=0.8 in the agents' shell so host_load.py sizes runs to match.
